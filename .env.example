# ==========================================
# Application
# ==========================================

NODE_ENV=development

BACKEND_PORT=8000
FRONTEND_PORT=3000

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=vidscribe_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=


# ==========================================
# Ollama
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_MS=120000


# ==========================================
# RAG
# ==========================================

RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.40
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=300