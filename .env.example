# ==========================================
# Application
# ==========================================

NODE_ENV=development

BACKEND_PORT=8000
FRONTEND_PORT=3000

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=vidscribe_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=


# ==========================================
# Optional Ollama answer provider (not required for indexing or search)
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:1b
OLLAMA_REQUEST_TIMEOUT_MS=120000
AI_REQUEST_TIMEOUT_MS=120000


# ==========================================
# RAG
# ==========================================

RAG_TOP_K=4
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=300

# ==========================================
# Background ingestion worker
# ==========================================

INGESTION_WORKER_POLL_INTERVAL_MS=1000
INGESTION_JOB_LEASE_DURATION_MS=90000
INGESTION_MAX_WORKER_ATTEMPTS=3

# Persisted chat answer claims
CHAT_GENERATION_LEASE_DURATION_MS=180000
