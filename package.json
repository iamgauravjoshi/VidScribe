{
  "name": "vidscribe",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace=@vidscribe/backend",
    "dev:frontend": "npm run dev --workspace=@vidscribe/frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@vidscribe/backend",
    "lint": "npm run lint --workspace=@vidscribe/frontend",
    "db:migrate": "npm run db:migrate --workspace=@vidscribe/backend"
  }
}
